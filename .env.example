# Copy this file to `.env` and add your Anthropic API key.

# This pipeline runs on Anthropic Claude.
LLM_PROVIDER=anthropic

# Your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-opus-4-8     # default; or claude-sonnet-4-6 to ~halve cost

# --- Optional: use Gemini instead (set LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your-gemini-key-here   # free key: https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional ---
# PDF_RENDER_DPI=170

# --- Government ID subsystem (app/gov/) ---------------------------------
# Required only when using the consent-gated ID reader. Generate real values:
#   CONSENT_SIGNING_KEY / BLIND_INDEX_PEPPER:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   FIELD_ENCRYPTION_KEY:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store these in a secrets manager / KMS in production -- NOT beside the database.

# Signs consent records so they are tamper-evident. Rotating it invalidates
# every existing consent signature.
# CONSENT_SIGNING_KEY=

# Keys the blind index used to de-duplicate ID numbers without storing them.
# An unkeyed hash of a 12-digit space is brute-forceable, so this is required.
# BLIND_INDEX_PEPPER=

# Encrypts the few fields kept in full. Losing it is unrecoverable.
# FIELD_ENCRYPTION_KEY=
