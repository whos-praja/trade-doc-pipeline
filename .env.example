# Copy this file to `.env` and add your Anthropic API key.

# This pipeline runs on Anthropic Claude.
LLM_PROVIDER=anthropic

# Your Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-opus-4-8     # default; or claude-sonnet-4-6 to ~halve cost

# --- Optional: use Gemini instead (set LLM_PROVIDER=gemini) ---
# GEMINI_API_KEY=your-gemini-key-here   # free key: https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-2.5-flash

# --- Optional ---
# PDF_RENDER_DPI=170
